@startuml
skinparam dpi 150
skinparam classAttributeIconSize 0
hide empty members

' One defensible design for the chapter 8 library specification.
' Book and DVD share the Borrowable abstraction; ReferenceItem does not.
abstract class Item {
  - title : String
  - catalogueNumber : String
  + getTitle() : String
  + getCatalogueNumber() : String
}

interface Borrowable {
  + getLoanPeriodDays() : int
}

class Book {
  + getLoanPeriodDays() : int
}
class DVD {
  + getLoanPeriodDays() : int
}
class ReferenceItem

abstract class LibraryUser {
  - userId : String
  + getUserId() : String
}
class Member {
  - memberNumber : String
  + logIn(memberNumber : String) : boolean
  + requestHold(item : Item) : boolean
}
class Librarian {
  + addItem(item : Item) : void
  + waiveLateFee(member : Member) : void
}

class Library {
  - catalogue : Map<String, Item>
  - loans : List<Loan>
  - holds : List<Hold>
  + addItem(item : Item) : void
  + isOnLoan(item : Item) : boolean
  + placeHold(member : Member, item : Item) : boolean
  + waiveLateFee(member : Member) : void
}

class Loan {
  - item : Item
  - borrower : Member
  - dueDate : LocalDate
  - returned : boolean
  + isActive() : boolean
}

class Hold {
  - item : Item
  - requester : Member
  - placedAt : LocalDateTime
  - active : boolean
}

Item <|-- Book
Item <|-- DVD
Item <|-- ReferenceItem
Borrowable <|.. Book
Borrowable <|.. DVD
LibraryUser <|-- Member
LibraryUser <|-- Librarian
Library "1" o-- "0..*" Item : catalogue
Library "1" o-- "0..*" Loan : tracks
Library "1" o-- "0..*" Hold : tracks
Loan "0..*" --> "1" Member : borrower
Loan "0..*" --> "1" Item : item
Hold "0..*" --> "1" Member : requester
Hold "0..*" --> "1" Item : item
Member ..> Library : requests hold
Librarian ..> Library : manages
@enduml
